  {
    "_comment": "下面的例子演示「纯配置接入」：不需要写代码，只要接口是 GET 一个 URL、余额在某个字段里。把 enabled 改成 true 并把 env 换成你自己的环境变量名即可。更多说明见 docs/ADD-PROVIDER.md",
    "id": "example-generic",
    "label": "示例供应商",
    "color": "#22C55E",
    "icon": "icons/example-generic.png",
    "enabled": false,
    "auth": { "env": ["EXAMPLE_API_KEY"], "header": "Authorization", "scheme": "Bearer " },
    "request": {
      "url": "https://api.example.com/v1/account/balance",
      "headers": { "X-Extra-Header": "value" }
    },
    "response": {
      "listPath": "data.balances",
      "amountPath": "available",
      "capacityPath": "total",
      "unitPath": "unit",
      "labelPath": "name",
      "expiresPath": "expire_at"
    },
    "reference": 10
  }
]
